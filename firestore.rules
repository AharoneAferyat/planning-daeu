rules_version = '2';
// Règles volontairement ouvertes : le site est partagé uniquement entre nous.
// L'accès est filtré dans l'appli par les codes d'invitation, les PIN et le PIN admin.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
